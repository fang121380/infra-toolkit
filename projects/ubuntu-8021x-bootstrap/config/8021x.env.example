# Copy to a local file outside the repository and chmod 600.
CONNECTION_NAME=corp-wired-8021x
INTERFACE_NAME=CHANGE_ME
EAP_IDENTITY=host/CHANGE_ME
CA_CERT=/etc/ssl/certs/org-root-ca.pem
CLIENT_CERT=/etc/ssl/private/8021x-client.crt
CLIENT_KEY=/etc/ssl/private/8021x-client.key
KEY_PASSWORD_FILE=
AUTOCONNECT=yes
